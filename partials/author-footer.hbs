<div class="clearfix author-footer">
    <img class="profile-image" src="{{@blog.logo}}" />
        <div class="author-name">{{@blog.title}}</div>
        <div class="author-description">{{@blog.description}}</div>
         {{#if author.location}}
            <p class="address">{{author.location}}</p>
         {{/if}}
	<span class="description typeit typewrite" data-period="3000" data-type='[ "{{@blog.description}}" ]' aria-label="cesar.velandia.co">
        	<span class="wrap"></span>
      	</span>
	</div>  
</div>

