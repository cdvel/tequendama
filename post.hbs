{{!< default}}
<div class="container clearfix">
  <main role="main" class="content">
    {{#post}}
    <h1><a href="{{url}}" title="{{title}}">{{title}}</a></h1>
    {{#has any="custom_excerpt"}}<code>{{custom_excerpt}}</code> {{/has}}
    {{!-- <footer class="post-info">Last updated on <span class="post-meta"><time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="Do MMMM YYYY"}}</time> {{tags separator=" " prefix="Tagged in "}}</span></footer> --}}
    <footer class="post-info no-index"><span class="post-meta">{{tags separator=" " prefix=""}}</span></footer>
    <aside class="toc"></aside>
    <hr/>
    <div class="post-content">
      {{content}}
    </div>
    </article>
    <section class="article-comments gh-canvas">
      <div id="disqus_thread"></div>
      <script>
          var disqus_config = function () {
          this.page.url = "{{url absolute=true}}"
          this.page.identifier = "ghost-{{comment_id}}";
          };
          (function() {
          var d = document, s = d.createElement('script');
          s.src = 'https://cdvel.disqus.com/embed.js';
          s.setAttribute('data-timestamp', +new Date());
          (d.head || d.body).appendChild(s);
          })();
      </script>
    </section>
  {{/post}}
</main>
</div>
